# Copy this file to `.env` in this same directory (engine/.env) and fill in
# your keys. Never commit the real .env file — it's already covered by
# engine/.gitignore.
#
# Groq is the primary AI notes provider; Gemini is the automatic fallback if
# a Groq request fails (timeout, rate limit, server error). Either key can
# be left blank — the engine will simply skip that provider and, if both are
# blank, mark AI analysis as "pending" and let you retry once a key is added
# (transcription itself never depends on these — it's fully local).

GROQ_API_KEY=
GEMINI_API_KEY=
